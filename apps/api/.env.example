# Server
PORT=4000
NODE_ENV=development

# PostgreSQL — Neon: Dashboard → Connect → Connection string (?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooler) URL for prisma migrate deploy when RLS roles are split (optional).
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Local alternative:
# DATABASE_URL=postgresql://gospots:gospots_dev@127.0.0.1:5432/gospots?schema=public
# Opt-in live Postgres concurrency suite (default `pnpm test` never runs these):
# RUN_CONCURRENCY_TESTS=1
# Then: pnpm test:concurrency  (see docs/audit/GO_SPOTS_CONCURRENCY_TESTS.md)

# Tenant RLS (bible #3) — default off. After migrate 20260721050000_tenant_rls_core:
# set TENANT_RLS=on so venue-bound requests SET LOCAL app.current_shop_id + app.rls_mode.
# Policies fail-open when mode unset (safe before flag flip). See docs/audit/GO_SPOTS_RLS.md.
# TENANT_RLS=off

# Financial ledger dual-write (bible #6) — default off. After migrate 20260721100000_ledger_entry:
# set LEDGER_DUAL_WRITE=on to post LedgerEntry alongside Transaction/Order/Play/Reservation/Loss.
# After dual-write soak + `pnpm run backfill:ledger -- --apply`, set LEDGER_READS=on so
# analytics prefer ledger SALE-by-channel (still falls back off when unset). See GO_SPOTS_LEDGER.md.
# LEDGER_DUAL_WRITE=off
# LEDGER_READS=off

# Resource/dining advisory dual-write (bible #14 Phase 2) — default ON after migrate
# 20260721120000_seating_source_dining_table_group. Mirrors DiningTableGroup → SeatingTableGroup
# via sourceDiningTableGroupId (totalCount only; never auto-sync availableCount from bookings).
# Set RESOURCE_DINING_DUAL_WRITE=off to disable. See docs/audit/GO_SPOTS_RESOURCE_MODEL_MERGE.md.
# RESOURCE_DINING_DUAL_WRITE=on
# Emergency only — allow staff manual edits to non-custom advisory seating mirrors:
# SEATING_MIRROR_MANUAL_OVERRIDE=on

# Auth (use long random strings in production — openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=900
# Default session (no remember-me): 12h absolute refresh window.
JWT_REFRESH_TTL=43200
# Remember-me: 30d absolute refresh window.
JWT_REFRESH_TTL_REMEMBER=2592000
# Idle timeout: 30m without remember-me; 7d with remember-me.
AUTH_IDLE_TTL_SEC=1800
AUTH_IDLE_TTL_REMEMBER_SEC=604800
# Optional dedicated AES key for owner TOTP secrets (64 hex chars). Falls back to JWT_ACCESS_SECRET.
# MFA_TOTP_ENCRYPTION_KEY=
# Optional elevated staff MFA opt-in (Phase 1). Default off — managers / membership OWNER only.
# STAFF_MFA_OPT_IN=on

# Frontend URL(s) — comma-separated for preview + production.
# CORS allowlist is the union of these (trim, no trailing slash).
# Prefer CORS_ORIGINS; CORS_ORIGIN / WEB_* kept for backwards compatibility.
# Non-prod: if all empty, defaults to http://localhost:3000 (local web→api).
# Production: localhost/loopback stripped; empty allowlist = CORS denied (no reflection).
CORS_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Cookies (set in auth.controller via resolveAuthCookieFlags):
# - access_token / refresh_token: httpOnly; csrf_token: NOT httpOnly (double-submit).
# - Path: access+csrf `/`; refresh `/api/v1/auth`. Always set on set/clear.
# - Secure: auto-on when NODE_ENV=production; local HTTP stays Secure=false.
#   Set COOKIE_SECURE=true for HTTPS local; COOKIE_SECURE=false to override prod.
# - SameSite: prefer `lax` with Vercel same-origin `/api/v1` proxy.
#   `none` only for cross-site API (forces Secure; keep CSRF_PROTECTION=true —
#   browsers send cookies on cross-site requests, so CSRF is load-bearing).
#   `strict` is safer for CSRF but can drop cookies on top-level nav from email links.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# CSRF double-submit is on by default for cookie-authenticated mutations.
# CSRF_PROTECTION=true

# Rate limiting (Nest Throttler). Defaults are production-safe.
# Local smoke / load tests: raise limits or set THROTTLE_DISABLED=true (never in prod).
# THROTTLE_DISABLED=false
# THROTTLE_TTL_MS=60000
# THROTTLE_GLOBAL_LIMIT=100
# Auth (per IP per TTL window):
# AUTH_THROTTLE_STRICT_LIMIT=5
# AUTH_THROTTLE_LOGIN_LIMIT=10
# AUTH_THROTTLE_REFRESH_LIMIT=30
# AUTH_THROTTLE_CSRF_LIMIT=60
# Public creates (per IP; under global limit).
# PUBLIC_THROTTLE_BOOKING_LIMIT=5
# PUBLIC_THROTTLE_EVENT_LIMIT=5
# PUBLIC_THROTTLE_CONTACT_LIMIT=5
# PUBLIC_THROTTLE_REVIEW_LIMIT=5
# PUBLIC_THROTTLE_CHAT_OPEN_LIMIT=5
#
# CAPTCHA on public creates (bible #26 / GO_SPOTS_PUBLIC_ABUSE.md).
# Default off = limits only (assertCaptchaOrThrow is wired but no-ops).
# Enable only after Turnstile/hCaptcha widget + secrets; keep off for Friday.
# Token: JSON body captchaToken (preferred) or X-Captcha-Token header.
# CAPTCHA_MODE=after_throttle: require token only after public-create 429
# (in-memory escalation map; process-local). CAPTCHA_MODE=always: every create.
# CAPTCHA_PROVIDER=off
# CAPTCHA_MODE=after_throttle
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# Finance Idempotency-Key (Phase 3 — see docs/audit/GO_SPOTS_IDEMPOTENCY.md).
# Default off: missing key on Tier A money paths still passthrough (no receipt).
# When true|1: Tier A finance mutations reject missing Idempotency-Key with 400.
# Tier B/C stay optional. Web clients already mint keys on these paths.
# IDEMPOTENCY_REQUIRE_MONEY_KEYS=false

# Legacy disk `/uploads` static serve (bible #27 Phase 1).
# Default on: keeps pre-StoredImage URLs working. New uploads use GET /media/:id.
# After `pnpm run inventory:legacy-uploads` reports total 0 (and migrate if needed):
# LEGACY_UPLOADS_STATIC=false
# LEGACY_UPLOADS_STATIC=true

# Resend — https://resend.com (required for guest booking emails)
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=bookings@yourdomain.com
# MAIL_FROM_NAME=GoSpots

# GDPR retention cron (daily 03:00 UTC) — guest PII redact by age; money rows kept.
# Set off to disable. Neon migrate 20260721070000_gdpr_consent_dsar required for consent/DSAR tables.
# GDPR_RETENTION_CRON=on

# ── Dual-provider SaaS billing (Stripe + Mollie) ─────────────────────────────
# Master switch. When false, dual orchestrator/cron are off (Lemon legacy only if enabled).
# BILLING_ENABLED=false
# BILLING_STRIPE_ENABLED=false
# BILLING_MOLLIE_ENABLED=false
# BILLING_DEFAULT_PROVIDER=STRIPE
# BILLING_GRACE_PERIOD_DAYS=3
# BILLING_WEBHOOK_MAX_ATTEMPTS=8
# BILLING_CRON=on
# Soft-deprecated Lemon path (default off). Legacy escape hatch for emergency checkout:
# BILLING_LEMON_ENABLED=false
# BILLING_LEMON_LEGACY_CHECKOUT=false

# Stripe (test keys locally). Required when BILLING_STRIPE_ENABLED=true in production.
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# Optional API version pin (defaults in StripeBillingAdapter if unset).
# STRIPE_API_VERSION=2026-07-29.dahlia
# Optional Price id map JSON — flat { "gaming_suite": "price_…" } or per-currency
# { "EUR": { "pack:gaming": "price_…", "gaming_suite": "price_…" } }
# STRIPE_PRICE_MAP=
# Webhook URL: https://YOUR_API/api/v1/billing/webhooks/stripe

# Mollie (test_… keys locally). Required when BILLING_MOLLIE_ENABLED=true in production.
# MOLLIE_API_KEY=test_xxxxx
# MOLLIE_PROFILE_ID=pfl_xxxxx
# MOLLIE_WEBHOOK_MODE=test
# Webhook URL: https://YOUR_API/api/v1/billing/webhooks/mollie

# Lemon Squeezy — LEGACY Merchant of Record (soft-deprecated; prefer Stripe/Mollie).
# Create one subscription product/variant; checkout uses custom_price for pack+add-ons.
# Local/dev may omit these (API warns; webhooks rejected until secret is set).
# Production boot fails without LEMON_SQUEEZY_WEBHOOK_SECRET when BILLING_LEMON_ENABLED=true.
# LEMON_SQUEEZY_API_KEY=your_api_key
# LEMON_SQUEEZY_STORE_ID=12345
# LEMON_SQUEEZY_VARIANT_ID=67890
# LEMON_SQUEEZY_WEBHOOK_SECRET=whsec_xxxxx
# Webhook URL: https://YOUR_API/api/v1/billing/webhooks/lemon-squeezy
# Events: subscription_created, subscription_updated, subscription_cancelled,
#         subscription_expired, subscription_paused, subscription_resumed, subscription_unpaused

# Health probes (no extra env): liveness GET /api/v1/live or /api/v1/health;
# readiness GET /api/v1/ready (includes DB).

# GDPR retention cron (bible #25) — daily 03:00 UTC advisory-locked pass.
# Redacts aged guest PII; strips old audit identifiers; deletes old analytics /
# expired auth sessions. Never deletes money rows. Default on; set off to disable.
# GDPR_RETENTION_CRON=on
# GDPR_RETENTION_CRON=off

# Mail outbox SENT retention (bible #22 Phase 3) — daily 04:00 UTC advisory-locked purge.
# Deletes SENT rows where sentAt is older than N days (payload holds PII). Default off.
# MAIL_OUTBOX_SENT_RETENTION_CRON=on
# MAIL_OUTBOX_SENT_RETENTION_DAYS=90

# Observability (optional — unset = Nest logger only; no Sentry network calls).
# When SENTRY_DSN is set, @sentry/node inits at boot (fail-open). PII scrubbed.
# See docs/audit/GO_SPOTS_OBSERVABILITY.md. Do not commit a real DSN.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Prometheus-style scrape at GET /api/v1/metrics (404 when off). No OTel SDK.
# METRICS_ENDPOINT=on
# Optional: require Authorization: Bearer <token> when endpoint is on
# METRICS_BEARER_TOKEN=