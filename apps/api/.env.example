# Server
PORT=4000
NODE_ENV=development

# PostgreSQL — Neon: Dashboard → Connect → Connection string (?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Local alternative:
# DATABASE_URL=postgresql://gospots:gospots_dev@127.0.0.1:5432/gospots?schema=public

# Auth (use long random strings in production — openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Frontend URL(s) — comma-separated for preview + production
WEB_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Cookies: production HTTPS / cross-origin API
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# Resend — https://resend.com (required for guest booking emails)
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=bookings@yourdomain.com
# MAIL_FROM_NAME=GoSpots

# Lemon Squeezy — SaaS billing (Merchant of Record, multi-currency + tax)
# Create one subscription product/variant; checkout uses custom_price for pack+add-ons.
# LEMON_SQUEEZY_API_KEY=your_api_key
# LEMON_SQUEEZY_STORE_ID=12345
# LEMON_SQUEEZY_VARIANT_ID=67890
# LEMON_SQUEEZY_WEBHOOK_SECRET=whsec_xxxxx
# Webhook URL: https://YOUR_API/api/v1/billing/webhooks/lemon-squeezy
# Events: subscription_created, subscription_updated, subscription_cancelled,
#         subscription_expired, subscription_paused, subscription_resumed, subscription_unpaused
