# Copy values into Render → Environment (do not commit real secrets)

NODE_ENV=production
PORT=10000

# Neon → Connection string tab (include ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Your Vercel URL(s), comma-separated for previews
WEB_ORIGIN=https://your-project.vercel.app
WEB_APP_URL=https://your-project.vercel.app
CORS_ORIGIN=https://your-project.vercel.app

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
