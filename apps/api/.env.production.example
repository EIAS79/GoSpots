# Copy values into Render → Environment (do not commit real secrets)

NODE_ENV=production
PORT=10000

# Neon → Connection string tab (include ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional direct URL for migrate when using split migrate/app roles (GO_SPOTS_RLS.md).
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Tenant RLS — keep off until migrate 20260721050000_* applied + soak; then TENANT_RLS=on.
# TENANT_RLS=off

# Ledger dual-write — keep off until migrate 20260721100000_* applied + soak; then LEDGER_DUAL_WRITE=on.
# After soak + backfill:ledger --apply, optionally LEDGER_READS=on (analytics prefer ledger).
# LEDGER_DUAL_WRITE=off
# LEDGER_READS=off

# Resource/dining advisory dual-write (bible #14) — default on after migrate 20260721120000_*.
# RESOURCE_DINING_DUAL_WRITE=on

# JWT — required at API boot in production (see assertCriticalSecretsAtBoot)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=43200
JWT_REFRESH_TTL_REMEMBER=2592000
AUTH_IDLE_TTL_SEC=1800
AUTH_IDLE_TTL_REMEMBER_SEC=604800
# Optional dedicated AES-256 key for owner TOTP secrets (64 hex). Falls back to JWT_ACCESS_SECRET.
# MFA_TOTP_ENCRYPTION_KEY=
# STAFF_MFA_OPT_IN=on

# Browser origins allowed for credentialed CORS (comma-separated).
# Prefer CORS_ORIGINS; CORS_ORIGIN / WEB_* are merged into the same allowlist.
# Must match the real Vercel / custom domain(s). Localhost is ignored in production.
# Empty allowlist → CORS denied (no Origin reflection, credentials off).
CORS_ORIGINS=https://your-project.vercel.app
WEB_ORIGIN=https://your-project.vercel.app
WEB_APP_URL=https://your-project.vercel.app
CORS_ORIGIN=https://your-project.vercel.app

# Cookie flags (see resolveAuthCookieFlags): Secure also auto-on via NODE_ENV=production.
COOKIE_SECURE=true
# Prefer lax + Vercel `/api/v1` proxy (same-origin). Use none only for cross-site API
# (forces Secure; CSRF must stay on). strict may break email/login top-level navigations.
COOKIE_SAME_SITE=lax
# Double-submit CSRF for cookie-auth mutations (default on). Keep with SameSite=lax + Vercel proxy.
CSRF_PROTECTION=true

# Rate limiting — keep enabled in production (never set THROTTLE_DISABLED=true).
# Code defaults match these values if unset; set explicitly for clarity.
THROTTLE_TTL_MS=60000
THROTTLE_GLOBAL_LIMIT=100
AUTH_THROTTLE_STRICT_LIMIT=5
AUTH_THROTTLE_LOGIN_LIMIT=10
AUTH_THROTTLE_REFRESH_LIMIT=30
AUTH_THROTTLE_CSRF_LIMIT=60
# Public creates (layered under THROTTLE_GLOBAL_LIMIT).
PUBLIC_THROTTLE_BOOKING_LIMIT=5
PUBLIC_THROTTLE_EVENT_LIMIT=5
PUBLIC_THROTTLE_CONTACT_LIMIT=5
PUBLIC_THROTTLE_REVIEW_LIMIT=5
PUBLIC_THROTTLE_CHAT_OPEN_LIMIT=5
# CAPTCHA on public creates — keep off until site/secret keys + guest widget are live.
# Wiring ready: assert + after_throttle 429 escalation map (process-local).
# Do not set CAPTCHA_PROVIDER=turnstile|hcaptcha in prod without secrets + widget.
# CAPTCHA_PROVIDER=off
# CAPTCHA_MODE=after_throttle
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Finance Idempotency-Key — require on Tier A money paths (transactions, orders create/add-line,
# losses create, play mark-paid/cancel/create). Missing header → 400. Tier B/C stay optional.
# Leave false until all clients send Idempotency-Key; then flip true in production.
IDEMPOTENCY_REQUIRE_MONEY_KEYS=true

# Legacy disk `/uploads` static (bible #27 Phase 1). Keep true until inventory total is 0.
# New images are StoredImage + /media/:id. See GO_SPOTS_UPLOAD_SECURITY.md.
LEGACY_UPLOADS_STATIC=true

# Resend — required in production (password reset + booking emails)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=bookings@yourdomain.com
MAIL_FROM_NAME=GoSpots

# Dual-provider SaaS billing (Stripe + Mollie). Keep BILLING_ENABLED=false until secrets + webhooks ready.
BILLING_ENABLED=false
BILLING_STRIPE_ENABLED=false
BILLING_MOLLIE_ENABLED=false
BILLING_DEFAULT_PROVIDER=STRIPE
BILLING_GRACE_PERIOD_DAYS=3
BILLING_WEBHOOK_MAX_ATTEMPTS=8
# BILLING_CRON=on
# Soft-deprecated Lemon; rollback escape hatch only.
BILLING_LEMON_ENABLED=false
BILLING_LEMON_LEGACY_CHECKOUT=false

# Stripe — required when BILLING_STRIPE_ENABLED=true (boot fails fast if secret/webhook missing).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2026-07-29.dahlia
# Optional JSON Price map (flat or per-currency). Leave empty to use price_data amounts.
# STRIPE_PRICE_MAP=
# Webhook URL: https://YOUR_API/api/v1/billing/webhooks/stripe

# Mollie — required when BILLING_MOLLIE_ENABLED=true (boot fails fast if API key missing).
MOLLIE_API_KEY=
MOLLIE_PROFILE_ID=
MOLLIE_WEBHOOK_MODE=live
# Webhook URL: https://YOUR_API/api/v1/billing/webhooks/mollie

# Lemon Squeezy — LEGACY paid checkout + webhooks (prefer Stripe/Mollie).
# API boot fails fast if LEMON_SQUEEZY_WEBHOOK_SECRET is missing when BILLING_LEMON_ENABLED=true.
# Unsigned webhooks are never accepted (503 when secret unset; 401 on bad HMAC).
# Checkout keys (API_KEY / STORE_ID / VARIANT_ID) are required only to start paid Lemon checkout.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Webhook URL: https://YOUR_API/api/v1/billing/webhooks/lemon-squeezy
# Events: subscription_created, subscription_updated, subscription_cancelled,
#         subscription_expired, subscription_paused, subscription_resumed, subscription_unpaused

# GDPR retention cron (bible #25) — default on. Set off to disable daily pass.
# Never deletes money rows. See GO_SPOTS_GDPR_RETENTION.md.
# GDPR_RETENTION_CRON=on

# Mail outbox SENT retention (bible #22) — default off. Purges old SENT rows by sentAt.
# MAIL_OUTBOX_SENT_RETENTION_CRON=on
# MAIL_OUTBOX_SENT_RETENTION_DAYS=90

# Health probes (no extra env): liveness GET /api/v1/live or /api/v1/health;
# readiness GET /api/v1/ready (includes DB). Set host healthCheckPath accordingly.

# Observability (optional — unset = Nest logger only). See GO_SPOTS_OBSERVABILITY.md.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Prometheus scrape GET /api/v1/metrics (404 when off). Restrict at edge / internal only.
# METRICS_ENDPOINT=on
# Optional: Authorization: Bearer <token> when scrape is exposed beyond private network
# METRICS_BEARER_TOKEN=
