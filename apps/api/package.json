  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest build && nest start --watch",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "migrate:deploy": "prisma migrate deploy",
    "postbuild": "prisma generate",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "test": "jest --config jest.config.cjs",
    "test:billing": "jest --config jest.config.cjs --testPathPattern=modules/billing"
  },
  "dependencies": {
