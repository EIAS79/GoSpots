// Phase 10 — Workforce, Time Clock, Staff Accountability and Owner Controls
// Membership remains authentication/permission + branch access truth, including isActive.
// EmployeeRate remains effective-dated labor-cost truth.
// These rows add employment metadata, operator attribution, approvals and owner controls.

model StaffEmploymentProfile {
  id                  String   @id @default(cuid())
  shopId              String
  membershipId        String
  employeeNumber      String
  displayName         String?
  primaryJobRoleId    String?
  managerMembershipId String?
  createdById         String
  updatedById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([shopId, membershipId])
  @@unique([shopId, employeeNumber])
  @@index([shopId, employeeNumber])
  @@index([shopId, managerMembershipId])
}

model StaffOperatorCredential {
  id             String   @id @default(cuid())
  shopId         String
  membershipId   String
  pinHash        String
  badgeHash      String?
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  active         Boolean  @default(true)
  rotatedAt      DateTime @default(now())
  createdById    String
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shopId, membershipId])
  @@unique([shopId, badgeHash])
  @@index([shopId, active, lockedUntil])
}

model StaffOperatorSession {
  id           String    @id @default(cuid())
  shopId       String
  membershipId String
  tokenHash    String    @unique
  authStrength String
  workstation  String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  @@index([shopId, membershipId, expiresAt])
  @@index([shopId, revokedAt, expiresAt])
}

model StaffApprovalPolicy {
  id                   String   @id @default(cuid())
  shopId               String
  actionKind           String
  enabled              Boolean  @default(false)
  amountThresholdMinor Int?
  requirePassword      Boolean  @default(true)
  notifyOnUse          Boolean  @default(true)
  version              Int      @default(1)
  createdById          String
  updatedById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shopId, actionKind])
  @@index([shopId, enabled, actionKind])
}

model StaffApprovalRequestV2 {
  id                    String    @id @default(cuid())
  shopId                String
  actionKind            String
  requesterMembershipId String
  sourceType            String
  sourceId              String?
  amountMinor           Int?
  reason                String
  status                String    @default("PENDING")
  policyVersion         Int
  expiresAt             DateTime
  decidedByMembershipId String?
  decisionNote          String?
  decidedAt             DateTime?
  consumedAt            DateTime?
  consumedSourceId      String?
  createdAt             DateTime  @default(now())

  @@index([shopId, status, createdAt])
  @@index([shopId, requesterMembershipId, createdAt])
  @@index([shopId, actionKind, sourceType, sourceId])
}

model StaffNotificationRule {
  id                   String   @id @default(cuid())
  shopId               String
  actionKind           String
  enabled              Boolean  @default(true)
  amountThresholdMinor Int?
  repeatWindowMinutes  Int      @default(60)
  repeatCountThreshold Int      @default(3)
  afterHoursStartHour  Int?
  afterHoursEndHour    Int?
  version              Int      @default(1)
  createdById          String
  updatedById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shopId, actionKind])
  @@index([shopId, enabled, actionKind])
}

model StaffActionEvidence {
  id                   String   @id @default(cuid())
  shopId               String
  actionKind           String
  sourceType           String
  sourceId             String?
  actorMembershipId    String
  authenticatedUserId  String
  approverMembershipId String?
  approvalRequestId    String?
  authStrength         String
  amountMinor          Int?
  suspicious           Boolean  @default(false)
  suspiciousReasons    Json?
  context              Json?
  occurredAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([shopId, occurredAt])
  @@index([shopId, actorMembershipId, occurredAt])
  @@index([shopId, actionKind, occurredAt])
  @@index([shopId, suspicious, occurredAt])
  @@index([shopId, approvalRequestId])
}

model WorkforcePolicy {
  id                         String   @id @default(cuid())
  shopId                     String   @unique
  enforceSchedule            Boolean  @default(false)
  earlyClockInMinutes        Int      @default(15)
  lateGraceMinutes           Int      @default(5)
  overtimeWeeklySeconds      Int      @default(144000)
  minimumBreakAfterSeconds   Int      @default(21600)
  minimumBreakSeconds        Int      @default(1800)
  operatorSessionMinutes     Int      @default(15)
  pinLockoutAttempts         Int      @default(5)
  pinLockoutMinutes          Int      @default(15)
  updatedById                String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model ShiftSwapRequest {
  id                    String    @id @default(cuid())
  shopId                String
  scheduleEntryId       String
  requesterMembershipId String
  targetMembershipId    String?
  reason                String
  status                String    @default("PENDING")
  decidedByMembershipId String?
  decisionNote          String?
  decidedAt             DateTime?
  createdAt             DateTime  @default(now())

  @@index([shopId, status, createdAt])
  @@index([shopId, requesterMembershipId, createdAt])
  @@index([shopId, scheduleEntryId])
}
