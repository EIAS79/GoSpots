model ReservationDepositCheckoutAttempt {
  id                      String   @id @default(cuid())
  shopId                  String
  reservationId           String
  provider                String   @default("STRIPE")
  providerSessionId       String   @unique
  providerPaymentIntentId String?  @unique
  amountMinor             Int
  currency                String
  status                  String   @default("OPEN")
  idempotencyKey          String
  checkoutUrlHash         String?
  lastProviderEvent       String?
  failureCode             String?
  failureMessage          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  expiresAt               DateTime?
  succeededAt             DateTime?
  canceledAt              DateTime?

  @@unique([shopId, idempotencyKey])
  @@index([shopId, reservationId, createdAt])
  @@index([shopId, status, updatedAt])
}
