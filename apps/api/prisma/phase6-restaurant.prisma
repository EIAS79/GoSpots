// Phase 6 — restaurant/bar/cafe operational metadata.
// VenueOrder remains canonical order truth; GuestCheck/settlement remain financial truth.

enum RestaurantOrderLifecycle {
  DRAFT
  PLACED
  ACKNOWLEDGED
  IN_PREPARATION
  READY
  SERVED
  CANCELLED
  CLOSED
}

enum RestaurantOrderOrigin {
  STAFF
  CASHIER
  QR_TABLE
}

enum RestaurantFireState {
  HOLD
  FIRE_LATER
  FIRED
}

enum RestaurantPickupStatus {
  NOT_APPLICABLE
  PREPARING
  READY_FOR_PICKUP
  COLLECTED
}

enum RestaurantTabStatus {
  NONE
  OPEN
  CLOSED
}

enum RestaurantPrinterJobStatus {
  QUEUED
  PRINTING
  PRINTED
  FAILED
}

model MenuServiceModePolicy {
  id          String   @id @default(cuid())
  shopId      String
  menuItemId  String
  serviceMode String
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, menuItemId, serviceMode])
  @@index([shopId, serviceMode, enabled])
}

/// Restaurant-facing presentation and stock-restock metadata. MenuItem remains catalog truth.
model RestaurantMenuPresentation {
  id                String   @id @default(cuid())
  shopId            String
  menuItemId        String
  customerName      String?
  kitchenName       String?
  expectedRestockAt DateTime?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shopId, menuItemId])
  @@index([shopId, expectedRestockAt])
}

model MenuModifierAvailability {
  id                String   @id @default(cuid())
  shopId            String
  modifierId        String
  available         Boolean  @default(true)
  reason            String?
  expectedRestockAt DateTime?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shopId, modifierId])
  @@index([shopId, available])
  @@index([shopId, expectedRestockAt])
}

model RestaurantOrderOps {
  id                 String                   @id @default(cuid())
  shopId             String
  orderId            String                   @unique
  lifecycle          RestaurantOrderLifecycle @default(DRAFT)
  origin             RestaurantOrderOrigin    @default(STAFF)
  displayNumber      String
  prepQuoteMinutes   Int?
  pickupStatus       RestaurantPickupStatus   @default(NOT_APPLICABLE)
  tabStatus          RestaurantTabStatus      @default(NONE)
  tabName            String?
  preauthOperationId String?
  currentResourceId  String?
  version            Int                      @default(1)
  createdById        String?
  updatedById        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([shopId, displayNumber])
  @@index([shopId, lifecycle, updatedAt])
  @@index([shopId, tabStatus, updatedAt])
  @@index([shopId, pickupStatus, updatedAt])
}

model RestaurantOrderLineOps {
  id           String              @id @default(cuid())
  shopId       String
  orderId      String
  orderLineId  String              @unique
  courseNumber Int                 @default(1)
  fireState    RestaurantFireState @default(HOLD)
  priority     Int                 @default(0)
  rush         Boolean             @default(false)
  firedAt      DateTime?
  servedAt     DateTime?
  updatedById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([shopId, orderId, courseNumber, fireState])
}

model RestaurantTableTransfer {
  id             String   @id @default(cuid())
  shopId         String
  orderId        String
  fromResourceId String?
  toResourceId   String?
  movedLineIds   Json
  fromSeat       Int?
  toSeat         Int?
  actorUserId    String
  reason         String?
  createdAt      DateTime @default(now())

  @@index([shopId, orderId, createdAt])
}

model PrepStationGroup {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  expo      Boolean  @default(false)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, name])
  @@index([shopId, active, sortOrder])
}

model PrepStationGroupMember {
  id        String   @id @default(cuid())
  shopId    String
  groupId   String
  stationId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([shopId, groupId, stationId])
  @@index([shopId, stationId])
}

model PrepStationTimerPolicy {
  id          String   @id @default(cuid())
  shopId      String
  stationId   String
  warningPct  Int      @default(75)
  overduePct  Int      @default(100)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, stationId])
  @@index([shopId, stationId])
}

model PrepTicketControl {
  id               String   @id @default(cuid())
  shopId           String
  ticketId         String   @unique
  acknowledgedAt   DateTime?
  acknowledgedById String?
  recalledAt       DateTime?
  recalledById     String?
  priority         Int      @default(0)
  rush             Boolean  @default(false)
  held             Boolean  @default(false)
  holdUntil        DateTime?
  firedAt          DateTime?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([shopId, rush, priority, updatedAt])
}

model RestaurantPrinterRoute {
  id                 String   @id @default(cuid())
  shopId             String
  stationId          String
  printerKey         String
  fallbackPrinterKey String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([shopId, stationId])
  @@index([shopId, active])
}

model RestaurantPrinterJob {
  id             String                     @id @default(cuid())
  shopId         String
  ticketId       String
  stationId      String
  printerKey     String
  fallbackUsed   Boolean                    @default(false)
  sequenceNumber Int
  dedupKey       String
  status         RestaurantPrinterJobStatus @default(QUEUED)
  attempts       Int                        @default(0)
  lastError      String?
  printedAt      DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([shopId, dedupKey])
  @@unique([shopId, printerKey, sequenceNumber])
  @@index([shopId, status, createdAt])
  @@index([shopId, ticketId])
}

/// Stored token is hash-only. One table token owns one open GuestCheck so repeated QR ordering
/// stays in the same canonical commercial pipeline until the token is rotated/revoked.
model QrTableOrderToken {
  id           String   @id @default(cuid())
  shopId       String
  resourceId   String
  guestCheckId String?
  tokenHash    String   @unique
  expiresAt    DateTime
  maxUses      Int      @default(20)
  useCount     Int      @default(0)
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdById  String
  createdAt    DateTime @default(now())

  @@index([shopId, resourceId, expiresAt])
  @@index([shopId, guestCheckId])
  @@index([shopId, revokedAt])
}
