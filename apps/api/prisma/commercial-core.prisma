// Phase 4 — Commercial Core v2
// These records extend the canonical GuestCheck/CheckSettlement/Payment/LedgerEntry flow.
// Foreign keys are enforced by the Phase 4 migration while scalar IDs keep this schema
// decoupled from legacy relation churn.

enum CommercialCheckType {
  SESSION
  RESTAURANT_TABLE
  BAR_TAB
  COUNTER_SALE
  TAKEAWAY
  RESERVATION_EVENT
  RETAIL
}

enum CommercialAdjustmentType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  MANAGER_COMP
  PRICE_OVERRIDE
  PROMOTION
  DEPOSIT_APPLICATION
}

enum CommercialAdjustmentScope {
  CHECK
  LINE
}

enum CommercialAdjustmentSource {
  MANUAL
  PROMOTION
  MEMBERSHIP
  DEPOSIT
  SYSTEM
}

enum CommercialChargeMode {
  FIXED
  PERCENTAGE
}

enum CommercialTipMethod {
  CASH
  CARD
  OTHER
}

enum CommercialReopenDisposition {
  REOPENED_UNPAID
  REFUND_RESALE_REQUIRED
}

model CommercialPolicy {
  id                              String   @id @default(cuid())
  shopId                          String   @unique
  maxManualDiscountBps            Int      @default(10000)
  maxCompAmountMinor              Int      @default(1000000000)
  maxPriceOverrideBps             Int      @default(10000)
  allowCashShiftCloseWithOpenTabs Boolean  @default(false)
  allowResourceTransfer           Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@index([shopId])
}

model GuestCheckCommercialProfile {
  id                  String              @id @default(cuid())
  shopId              String
  guestCheckId        String              @unique
  checkType           CommercialCheckType @default(COUNTER_SALE)
  assignedOperatorId  String?
  resourceId          String?
  operationsSessionId String?
  tableReference      String?
  customerId          String?
  serviceArea         String?
  version             Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([shopId, checkType])
  @@index([shopId, assignedOperatorId])
  @@index([shopId, resourceId])
  @@index([shopId, operationsSessionId])
  @@index([shopId, customerId])
}

model CommercialAdjustment {
  id                  String                     @id @default(cuid())
  shopId              String
  guestCheckId        String
  type                 CommercialAdjustmentType
  scope                CommercialAdjustmentScope @default(CHECK)
  targetSourceType     String?
  targetSourceId       String?
  targetLineReference  String?
  amountMinor          Int?
  percentageBps        Int?
  beforeTotalMinor     Int
  afterTotalMinor      Int
  reason               String
  source               CommercialAdjustmentSource @default(MANUAL)
  createdById          String
  createdAt            DateTime                    @default(now())
  voidedAt             DateTime?
  voidedById           String?
  voidReason           String?

  @@index([shopId, guestCheckId, createdAt])
  @@index([shopId, guestCheckId, voidedAt])
  @@index([shopId, type, createdAt])
}

model GuestCheckServiceCharge {
  id            String               @id @default(cuid())
  shopId        String
  guestCheckId  String
  mode          CommercialChargeMode
  amountMinor   Int?
  percentageBps Int?
  reason        String
  createdById   String
  createdAt     DateTime             @default(now())
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  @@index([shopId, guestCheckId, createdAt])
  @@index([shopId, guestCheckId, voidedAt])
}

model GuestCheckTip {
  id           String              @id @default(cuid())
  shopId       String
  guestCheckId String
  method       CommercialTipMethod
  amountMinor  Int
  note         String?
  createdById  String
  createdAt    DateTime            @default(now())
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?

  @@index([shopId, guestCheckId, createdAt])
  @@index([shopId, guestCheckId, voidedAt])
}

model GuestCheckTransferEvent {
  id                      String   @id @default(cuid())
  shopId                  String
  guestCheckId            String
  actorId                 String
  reason                  String
  fromOperatorId          String?
  toOperatorId            String?
  fromResourceId          String?
  toResourceId            String?
  fromOperationsSessionId String?
  toOperationsSessionId   String?
  fromServiceArea         String?
  toServiceArea           String?
  createdAt               DateTime @default(now())

  @@index([shopId, guestCheckId, createdAt])
}

model GuestCheckReopenEvent {
  id            String                      @id @default(cuid())
  shopId        String
  guestCheckId  String
  settlementId  String?
  actorId       String
  reason        String
  disposition   CommercialReopenDisposition
  createdAt     DateTime                    @default(now())

  @@index([shopId, guestCheckId, createdAt])
  @@index([shopId, settlementId])
}

model CommercialReceipt {
  id            String   @id @default(cuid())
  shopId        String
  guestCheckId  String
  settlementId  String   @unique
  receiptNumber String
  currency      String
  totalMinor    Int
  snapshot      Json
  issuedAt      DateTime @default(now())
  createdById   String
  createdAt     DateTime @default(now())

  @@unique([shopId, receiptNumber])
  @@index([shopId, guestCheckId, issuedAt])
}

/// Semantic classification for the existing canonical LedgerEntry. This model
/// deliberately has no amount/currency columns, so it cannot become a second
/// financial truth. It only says what a LedgerEntry means in the Phase 4 domain.
model LedgerFactMetadata {
  id            String   @id @default(cuid())
  shopId        String
  ledgerEntryId String   @unique
  factType      String
  referenceType String
  referenceId   String
  guestCheckId  String?
  settlementId  String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@unique([shopId, factType, referenceType, referenceId])
  @@index([shopId, factType, createdAt])
  @@index([shopId, guestCheckId, createdAt])
  @@index([shopId, settlementId, createdAt])
}
